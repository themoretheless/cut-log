{
  "name": "cut-log-ui-framework-benchmark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "vue-tsc --noEmit -p tsconfig.vue.json && svelte-check --tsconfig ./tsconfig.svelte.json && tsc --noEmit -p tsconfig.retained.json && tsc --noEmit -p tsconfig.node.json",
    "bench": "npm run build && node ./scripts/run.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "25.9.3",
    "@vitejs/plugin-vue": "6.0.7",
    "playwright": "1.62.1",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vue": "3.5.38",
    "vue-tsc": "3.3.4"
  }
}
